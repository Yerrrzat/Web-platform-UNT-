# Copy to .env in the project root (Windows: copy config\.env.example .env). Never commit real secrets.
# Matches docker-compose.yml (local PostgreSQL)
DATABASE_URL="postgresql://unt:unt@127.0.0.1:5432/unt_prep"
# Long random string used to sign login sessions (at least 32 characters)
AUTH_SECRET="change-me-to-a-long-random-string-32-chars-min"
APP_URL="http://localhost:3000"
SMTP_HOST="smtp.example.com"
SMTP_USER="placeholder"
SMTP_PASSWORD="placeholder"
# "test" = test mode: no real money is charged
PAYMENT_PROVIDER="test"
PAYMENT_PUBLIC_ID="test_public_id"
PAYMENT_API_SECRET="test_api_secret"
FREE_VERSIONS_LIMIT=3
